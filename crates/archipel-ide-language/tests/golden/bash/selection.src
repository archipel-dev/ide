#!/usr/bin/env bash
# Deploy script.

set -euo pipefail

NAME="app"
readonly LIMIT=10

greet() {
  local who="$1"
  echo "hello $who"
}

deploy() {
  local target="$1"
  if [ -z "$target" ]; then
    echo "missing"
    return 1
  elif [ "$target" = "prod" ]; then
    echo "prod"
  else
    echo "other"
  fi
  for f in *.txt; do
    cat "$f"
  done
  while read -r line; do
    echo "$line"
  done < input.txt
  case "$target" in
    prod)
      g‸reet "ops"
      ;;
    *)
      greet "dev"
      ;;
  esac
}

deploy "$1"
