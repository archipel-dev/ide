{
  "id": "35",
  "title": "Unresolved assertThat: error marker from jdtls and the static import on Alt+Enter",
  "reference": null,
  "fixture": "java-gradle-assertj",
  "requires": ["jdtls"],
  "open": ["src/test/java/com/example/AppTest.java"],
  "steps": [
    {"op": "wait", "until": "idle"},
    {"op": "waitFor", "pointer": "/lsp/importing", "equals": true, "timeoutMs": 120000},
    {"op": "screenshot", "name": "35-importing.png"},
    {"op": "waitFor", "pointer": "/problems", "equals": 1, "timeoutMs": 300000},
    {"op": "assert", "pointer": "/lsp/importing", "equals": false},
    {"op": "assert", "pointer": "/activeTab", "equals": "src/test/java/com/example/AppTest.java"},
    {"op": "screenshot", "name": "35-unresolved-assertthat.png"},
    {"op": "execute", "command": "editor.gotoLine", "args": {"line": 8, "column": 12}},
    {"op": "sleep", "ms": 1500},
    {"op": "key", "chord": "Alt+Enter"},
    {"op": "waitFor", "pointer": "/intentions/popup", "equals": true, "timeoutMs": 60000},
    {"op": "assert", "pointer": "/intentions/rows/0", "contains": "static import"},
    {"op": "assert", "pointer": "/intentions/rows/0", "contains": "assertThat"},
    {"op": "screenshot", "name": "35-alt-enter-static-import.png"},
    {"op": "key", "chord": "Enter"},
    {"op": "waitFor", "pointer": "/editor/text", "contains": "import static org.assertj.core.api.Assertions.assertThat;", "timeoutMs": 60000},
    {"op": "waitFor", "pointer": "/problems", "equals": 0, "timeoutMs": 60000},
    {"op": "screenshot", "name": "35-import-applied.png"}
  ]
}
