{
  "id": "u05",
  "title": "UI spec capture (New UI Dark, new_ui look): Search Everywhere (Double Shift, query \"main\")",
  "reference": "reference/intellij-community/java-gradle/05-search-everywhere.png",
  "fixture": "java-gradle",
  "open": [
    "src/main/java/com/example/App.java"
  ],
  "steps": [
    {
      "op": "wait",
      "until": "idle"
    },
    {
      "op": "execute",
      "command": "settings.apply",
      "args": {
        "changes": {
          "appearance.uiLook": "new_ui",
          "appearance.theme": "New UI Dark",
          "appearance.compactMode": false
        }
      }
    },
    {
      "op": "execute",
      "command": "toolchain.dismissBanner",
      "args": {
        "language": "Java"
      }
    },
    {
      "op": "sleep",
      "ms": 800
    },
    {
      "op": "key",
      "chord": "DoubleShift"
    },
    {
      "op": "wait",
      "until": "popup"
    },
    {
      "op": "type",
      "text": "main"
    },
    {
      "op": "wait",
      "until": "idle"
    },
    {
      "op": "assert",
      "pointer": "/popups/searchEverywhere",
      "equals": "all"
    },
    {
      "op": "screenshot",
      "name": "u05-search-everywhere.png"
    },
    {
      "op": "key",
      "chord": "Escape"
    },
    {
      "op": "wait",
      "until": "idle"
    },
    {
      "op": "assert",
      "pointer": "/popups/searchEverywhere",
      "equals": null
    }
  ]
}