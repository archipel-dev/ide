{
  "title": "String assigned to Int in Kotlin",
  "requires": [
    "jdk",
    "kotlin-lsp",
    "gradle",
    "network"
  ],
  "open": "src/main/kotlin/demo/Main.kt",
  "steps": [
    {
      "op": "waitServer",
      "timeoutMs": 300000
    },
    {
      "op": "waitAnalysis",
      "name": "initial",
      "timeoutMs": 240000
    },
    {
      "op": "typeAt",
      "line": 4,
      "column": 21,
      "text": "\nval n: Int = \"text\""
    },
    {
      "op": "waitAnalysis",
      "name": "typed",
      "timeoutMs": 120000
    }
  ],
  "expect": {
    "markup": [
      {
        "when": "typed",
        "range": "5:18-5:24",
        "severity": "error",
        "message": "Initializer type mismatch: expected 'Int', actual 'String'.",
        "confidence": "unverified"
      }
    ]
  },
  "intellij": {
    "version": "IntelliJ IDEA 2025.2 (Kotlin K2 mode)",
    "action": "type val n: Int = \"text\"",
    "notes": "K2 wording; K1 says 'Type mismatch: inferred type is String but Int was expected'"
  }
}
