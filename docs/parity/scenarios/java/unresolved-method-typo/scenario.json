{
  "title": "Misspelled method on a String",
  "requires": [
    "jdk",
    "jdtls",
    "gradle",
    "network"
  ],
  "open": "src/main/java/demo/Texts.java",
  "steps": [
    {
      "op": "waitServer",
      "timeoutMs": 300000
    },
    {
      "op": "waitAnalysis",
      "name": "initial",
      "timeoutMs": 120000
    },
    {
      "op": "typeAt",
      "line": 5,
      "column": 29,
      "text": "\nint n = s.lenght();"
    },
    {
      "op": "waitAnalysis",
      "name": "typed",
      "timeoutMs": 120000
    }
  ],
  "expect": {
    "markup": [
      {
        "when": "typed",
        "range": "6:19-6:25",
        "severity": "error",
        "message": "Cannot resolve method 'lenght' in 'String'",
        "confidence": "unverified"
      }
    ]
  },
  "intellij": {
    "version": "IntelliJ IDEA 2025.2",
    "action": "type int n = s.lenght(); on a String",
    "notes": "the error covers the method name only"
  }
}
