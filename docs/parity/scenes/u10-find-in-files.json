{
  "id": "u10",
  "title": "UI spec capture (New UI Dark, new_ui look): Find in Files (query \"greeting\")",
  "reference": "reference/intellij-community/java-gradle/10-find-in-files.png",
  "fixture": "java-gradle",
  "open": [
    "src/main/java/com/example/App.java"
  ],
  "steps": [
    {
      "op": "wait",
      "until": "idle"
    },
    {
      "op": "execute",
      "command": "settings.apply",
      "args": {
        "changes": {
          "appearance.uiLook": "new_ui",
          "appearance.theme": "New UI Dark",
          "appearance.compactMode": false
        }
      }
    },
    {
      "op": "execute",
      "command": "toolchain.dismissBanner",
      "args": {
        "language": "Java"
      }
    },
    {
      "op": "sleep",
      "ms": 800
    },
    {
      "op": "key",
      "chord": "Primary+Shift+F"
    },
    {
      "op": "wait",
      "until": "idle"
    },
    {
      "op": "assert",
      "pointer": "/findInFiles/popup",
      "equals": true
    },
    {
      "op": "assert",
      "pointer": "/focus",
      "equals": "findInFiles"
    },
    {
      "op": "type",
      "text": "greeting"
    },
    {
      "op": "wait",
      "until": "idle"
    },
    {
      "op": "assert",
      "pointer": "/findInFiles/query",
      "equals": "greeting"
    },
    {
      "op": "assert",
      "pointer": "/findInFiles/results",
      "equals": 4
    },
    {
      "op": "screenshot",
      "name": "u10-find-in-files.png"
    }
  ]
}