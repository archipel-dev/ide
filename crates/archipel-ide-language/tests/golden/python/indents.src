import os
from typing import List


class Service(Base):
    """A service."""

    limit = 10

    def __init__(self, name):
        self.name = name

    @staticmethod
    def helper(a, b=2):
        if a > b:
            return a
        elif a == b:
            return b
        else:
            return 0

    async def run(self, items: List[int]) -> int:
        total = 0
        for item in items:
            try:
                total += item
            except ValueError as error:
                print(error)
            finally:
                pass
        while total > 0:
            total -= 1
        with open("f") as handle:
            data = [x for x in handle]
        return total


def main():
